{
  "templates": [
    {
      "id": "TPL-01",
      "file": "TPL-01_binary_2x2.xlsx",
      "name_zh": "二分类 2×2 四格表",
      "name_en": "Binary 2x2 fourfold table",
      "scenario": "二分类结局（事件数/总人数），实验组 vs 对照组。适用于 OR / RR / RD。",
      "measures": [
        "OR",
        "RR",
        "RD"
      ],
      "pdf_table_type": "T_DICHOT",
      "auto_status": "supported",
      "auto_note": "pdf_extractor P1 已自动识别有框 2×2 表（T_DICHOT），按列头关键词匹配实验/对照臂；无框表或扫描件需人工 colmap。",
      "demo_case": "C01",
      "validation": "event_* ≤ n_*；零事件单元 RR/OR 需连续性校正(+0.5)；多臂用 arm 列区分，考虑稳健方差估计(RVE)。",
      "columns": [
        {
          "key": "study",
          "zh": "研究",
          "required": true,
          "type": "text",
          "desc": "研究名称/ID（必填）"
        },
        {
          "key": "n_exp",
          "zh": "实验组人数",
          "required": true,
          "type": "int",
          "desc": "实验组（干预组）总人数"
        },
        {
          "key": "event_exp",
          "zh": "实验组事件数",
          "required": true,
          "type": "int",
          "desc": "实验组发生结局事件人数"
        },
        {
          "key": "n_ctrl",
          "zh": "对照组人数",
          "required": true,
          "type": "int",
          "desc": "对照组总人数"
        },
        {
          "key": "event_ctrl",
          "zh": "对照组事件数",
          "required": true,
          "type": "int",
          "desc": "对照组发生结局事件人数"
        },
        {
          "key": "year",
          "zh": "年份",
          "required": false,
          "type": "int",
          "desc": "发表年份（选填，元回归用）"
        },
        {
          "key": "arm",
          "zh": "臂标识",
          "required": false,
          "type": "text",
          "desc": "多臂/多对照试验用，区分同一试验不同干预臂"
        }
      ]
    },
    {
      "id": "TPL-02",
      "file": "TPL-02_continuous_twoarm.xlsx",
      "name_zh": "连续型两臂（均值±SD）",
      "name_en": "Continuous two-arm (mean ± SD)",
      "scenario": "连续型结局，实验组 vs 对照组各报告均值与标准差。适用于 MD（均数差）或 SMD（标准化均数差）。",
      "measures": [
        "MD",
        "SMD"
      ],
      "pdf_table_type": "T_CONTINUOUS / T_CONT_TWOARM",
      "auto_status": "partial",
      "auto_note": "pdf_extractor 可识别有框连续型表（T_CONTINUOUS / T_CONT_TWOARM）并抽取均值±SD 内联对，但连续型来源行在 P1 一律标记 needs_review（零样本精确匹配<50%），需人工确认 arm 方向与 SD 非 SEM。",
      "demo_case": "C04",
      "validation": "确保 SD 是标准差而非标准误(SEM)；支持输入均值±95%CI 自动转 SD；MD 要求同量纲，SMD 用于异量纲/不同量表。",
      "columns": [
        {
          "key": "study",
          "zh": "研究",
          "required": true,
          "type": "text",
          "desc": "研究名称/ID"
        },
        {
          "key": "n_exp",
          "zh": "实验组样本量",
          "required": true,
          "type": "int",
          "desc": "实验组样本量"
        },
        {
          "key": "mean_exp",
          "zh": "实验组均值",
          "required": true,
          "type": "float",
          "desc": "实验组均值"
        },
        {
          "key": "sd_exp",
          "zh": "实验组标准差",
          "required": true,
          "type": "float",
          "desc": "实验组标准差（SD，非 SEM）"
        },
        {
          "key": "n_ctrl",
          "zh": "对照组样本量",
          "required": true,
          "type": "int",
          "desc": "对照组样本量"
        },
        {
          "key": "mean_ctrl",
          "zh": "对照组均值",
          "required": true,
          "type": "float",
          "desc": "对照组均值"
        },
        {
          "key": "sd_ctrl",
          "zh": "对照组标准差",
          "required": true,
          "type": "float",
          "desc": "对照组标准差（SD，非 SEM）"
        },
        {
          "key": "year",
          "zh": "年份",
          "required": false,
          "type": "int",
          "desc": "发表年份"
        }
      ]
    },
    {
      "id": "TPL-03",
      "file": "TPL-03_precalculated_effect.xlsx",
      "name_zh": "已有效应量（对数尺度）",
      "name_en": "Pre-calculated effect sizes",
      "scenario": "文献已直接给出效应量及其 95%CI（如 lnOR / SMD / logHR / ROM / ZCOR）。适用于无法获得原始四格表/均值时。",
      "measures": [
        "lnOR",
        "SMD",
        "logHR",
        "ROM",
        "ZCOR"
      ],
      "pdf_table_type": "T_EFFECT_TABLE / T_MD_CI",
      "auto_status": "partial",
      "auto_note": "pdf_extractor 可识别已有效应量表（T_EFFECT_TABLE，含效应量±CI 行）；叙述性 MD(95%CI)（T_MD_CI）需人工映射为 SE。原始 OR 需先取对数。",
      "demo_case": "C06",
      "validation": "SE=(upper95−lower95)/(2×1.96)，vi=SE²；原始 OR 须先 ln 变换；ZCOR 为 Fisher z。",
      "columns": [
        {
          "key": "study",
          "zh": "研究",
          "required": true,
          "type": "text",
          "desc": "研究名称/ID"
        },
        {
          "key": "effect_type",
          "zh": "效应量类型",
          "required": true,
          "type": "choice",
          "choices": [
            "lnOR",
            "SMD",
            "logHR",
            "ROM",
            "ZCOR"
          ],
          "desc": "效应量类型（已取对数的值）"
        },
        {
          "key": "effect_size",
          "zh": "效应量",
          "required": true,
          "type": "float",
          "desc": "效应量值（如 lnOR，非原始 OR）"
        },
        {
          "key": "lower95",
          "zh": "95%CI下限",
          "required": true,
          "type": "float",
          "desc": "95%置信区间下限"
        },
        {
          "key": "upper95",
          "zh": "95%CI上限",
          "required": true,
          "type": "float",
          "desc": "95%置信区间上限"
        },
        {
          "key": "year",
          "zh": "年份",
          "required": false,
          "type": "int",
          "desc": "发表年份"
        }
      ]
    },
    {
      "id": "TPL-04",

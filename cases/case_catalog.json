      "name_zh": "率比（人时数据 IRR）",
      "name_en": "Rate ratio (person-time, IRR)",
      "scenario": "结局按人时（person-time，如千例患者日）计数的发生/未发生，实验组与对照组各给事件数与人时。适用于发生率比 IRR。",
      "measures": [
        "IRR"
      ],
      "pdf_table_type": "（暂无自动，需人工映射）",

          "required": true,
          "type": "int",
          "desc": "实验组事件数"
        },
        {
          "key": "b",
          "zh": "实验组人时",
          "required": true,
          "type": "float",
          "desc": "实验组人时（分母，如患者日/年）"
        },
        {
          "key": "c",
          "zh": "对照组事件数",
          "required": true,
          "type": "int",
          "desc": "对照组事件数"
        },
        {
          "key": "d",
          "zh": "对照组人时",
          "required": true,
          "type": "float",
          "desc": "对照组人时"
        },
        {
          "key": "year",
          "zh": "年份",
          "required": false,
          "type": "int",
          "desc": "发表年份"
        }
      ]
    },

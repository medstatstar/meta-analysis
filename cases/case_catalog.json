      "auto_note": "pdf_extractor P1 未覆盖生存 HR 表型；从文献 KM/Cox 结果表或 O-E/V 人工填入 lnHR 与 se(lnHR)。",
      "demo_case": "C11",
      "validation": "若文献给 O-E 与方差 V：lnHR≈O-E，se(lnHR)≈√V；若只给 HR 与 95%CI：se=(ln(upper)−ln(lower))/(2×1.96)。",
      "columns": [
        {
          "key": "study",
